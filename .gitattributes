# A checkout must be byte-identical on every platform: artifacts/paper/manifest.json
# records a SHA-256 per released file, and regenerating the tables and figures must
# leave an empty `git diff`. Normalize text to LF in the repository and in the
# working copy, and leave binary content untouched.
* text=auto eol=lf

# The released evidence package is content-addressed; never filter it at all.
artifacts/paper/** -text

# Binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.zip binary

# Windows batch files need CRLF.
*.bat text eol=crlf
