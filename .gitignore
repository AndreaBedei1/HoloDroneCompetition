# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Test, lint, type-check and coverage output
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Local Python and conda environments
.venv/
venv/
env/
ENV/
.conda/
conda-env/
.env
.env.*
!.env.example

# Editor, OS and local agent/tool state
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
.claude/settings.local.*
.agents/
.codex/

# Simulator and evaluation output. Everything a run writes is regenerable;
# the released evidence for the manuscript lives in artifacts/paper/.
/results/
/output/
/tmp/
logs/
runs/
recordings/
videos/
HoloOceanLogs/
Saved/

# Large media and raw array dumps
*.mp4
*.avi
*.mov
*.mkv
*.bag
*.ulg
*.npy
*.npz

# Temporary and backup files
*.tmp
*.bak
*.swp
*.swo
*~

# LaTeX build products. article_journal/main.pdf IS tracked so the compiled
# manuscript travels with its sources; every other build product stays out.
article_journal/*.aux
article_journal/*.bbl
article_journal/*.blg
article_journal/*.fdb_latexmk
article_journal/*.fls
article_journal/*.log
article_journal/*.out
article_journal/*.synctex.gz
article_journal/*.spl
article_journal/tmp/
